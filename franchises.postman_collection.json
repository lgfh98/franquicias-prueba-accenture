{
  "info": {
    "name": "Franchises API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Franquicias",
      "item": [
        {
          "name": "Crear franquicia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Franquicia Starbucks\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": ["{{baseUrl}}"],
              "path": ["franchises"]
            }
          }
        },
        {
          "name": "Actualizar nombre de franquicia",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Valdez Café Premium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/franchises/1/name",
              "host": ["{{baseUrl}}"],
              "path": ["franchises", "1", "name"]
            }
          }
        },
        {
          "name": "Obtener producto con mayor stock por sucursal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/franchises/1/max-stock-products",
              "host": ["{{baseUrl}}"],
              "path": ["franchises", "1", "max-stock-products"]
