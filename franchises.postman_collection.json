{
  "info": {
    "_postman_id": "franchise-api-collection-v1",
    "name": "Franchise API",
    "description": "Colección de pruebas para la API de Gestión de Franquicias",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Criterio Estrella",
      "item": [
        {
          "name": "Producto con mayor stock por sucursal (Franquicia 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/franchises/1/max-stock-products",
              "host": ["{{baseUrl}}"],
              "path": ["franchises", "1", "max-stock-products"]
            }
          }
        },
        {
          "name": "Producto con mayor stock por sucursal (Franquicia 2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/franchises/2/max-stock-products",
              "host": ["{{baseUrl}}"],
              "path": ["franchises", "2", "max-stock-products"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Criterios Obligatorios",
      "item": [
        {
          "name": "Crear Franquicia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Franquicia Starbucks\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": ["{{baseUrl}}"],
              "path": ["franchises"]
            }
          }
        },
        {
          "name": "Agregar Sucursal a Franquicia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sucursal Parque 93\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/franchises/1/branches",
              "host": ["{{baseUrl}}"],
              "path": ["franchises", "1", "branches"]
            }
          }
        },
        {
          "name": "Agregar Producto a Sucursal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Café Bourbon Rosado\",\n  \"stock\": 180\n}"
