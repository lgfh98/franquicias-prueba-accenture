        {
          "name": "Modificar Stock de Producto",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 350\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1", "stock"]
            }
          }
        },
        {
          "name": "Eliminar Producto de Sucursal",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/branches/1/products/3",
              "host": ["{{baseUrl}}"],
              "path": ["branches", "1", "products", "3"]
            }
          }
        }
      ]
