        {
          "name": "Listar franquicias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": ["{{baseUrl}}"],
              "path": ["franchises"]
            }
          }
        },
        {
          "name": "Obtener franquicia por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/franchises/1",
              "host": ["{{baseUrl}}"],
              "path": ["franchises", "1"]
            }
          }
        }
      ]
    },
